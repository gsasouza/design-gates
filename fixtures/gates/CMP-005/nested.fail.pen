{
  "version": "2.6",
  "variables": {
    "white": {
      "type": "color",
      "value": "#ffffff"
    },
    "ink": {
      "type": "color",
      "value": "#000000"
    }
  },
  "children": [
    {
      "id": "chip",
      "type": "frame",
      "name": "Chip",
      "reusable": true,
      "width": 50,
      "height": 20,
      "children": [
        {
          "id": "label",
          "type": "text",
          "content": "Go",
          "fill": "$ink",
          "opacity": 1,
          "enabled": true
        }
      ]
    },
    {
      "id": "card",
      "type": "frame",
      "name": "Card",
      "reusable": true,
      "width": 100,
      "height": 40,
      "children": [
        {
          "id": "inner",
          "type": "ref",
          "ref": "chip",
          "descendants": {
            "label": {
              "content": "Go"
            }
          }
        }
      ]
    },
    {
      "id": "screen",
      "type": "frame",
      "width": 300,
      "height": 300,
      "children": [
        {
          "id": "c1",
          "type": "ref",
          "ref": "card"
        },
        {
          "id": "c2",
          "type": "ref",
          "ref": "card"
        }
      ]
    }
  ]
}
