{
  "version": "2.6",
  "themes": { "mode": ["light", "dark"], "density": ["regular", "compact"] },
  "variables": {
    "a": { "type": "number", "value": [{ "value": 1, "theme": { "mode": "light", "density": "regular" } }] },
    "b": { "type": "number", "value": [{ "value": 1, "theme": { "mode": "light", "density": "regular" } }] }
  },
  "children": [
    { "id": "dark", "type": "frame", "width": 100, "height": 100, "theme": { "mode": "dark" }, "children": [{ "id": "dark-box", "type": "rectangle", "width": 10, "height": 10, "fill": "$a" }] }
  ]
}
