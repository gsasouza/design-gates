{
  "version": "2.6",
  "themes": { "mode": ["light", "dark"], "density": ["regular", "compact"] },
  "variables": { "gap": { "type": "number", "value": [{ "value": 1, "theme": { "mode": "light", "density": "regular" } }, { "value": 2, "theme": { "mode": "dark", "density": "regular" } }, { "value": 3, "theme": { "mode": "light", "density": "compact" } }] } },
  "children": [
    { "id": "compact-dark", "type": "frame", "width": 100, "height": 100, "theme": { "mode": "dark", "density": "compact" }, "children": [{ "id": "compact-dark-box", "type": "rectangle", "width": 10, "height": 10, "fill": "$gap" }] }
  ]
}
