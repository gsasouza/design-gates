{
  "version": "2.6",
  "themes": { "mode": ["light", "dark"] },
  "variables": { "text": { "type": "color", "value": "$gray-900" }, "gray-900": { "type": "color", "value": [{ "value": "#ffffff", "theme": { "mode": "light" } }] } },
  "children": [
    { "id": "dark", "type": "frame", "width": 100, "height": 100, "theme": { "mode": "dark" }, "children": [{ "id": "dark-box", "type": "rectangle", "width": 10, "height": 10, "fill": "$text" }] }
  ]
}
