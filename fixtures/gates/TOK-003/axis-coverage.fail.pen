{
  "version": "2.6",
  "themes": { "mode": ["light", "dark"] },
  "variables": { "bg": { "type": "color", "value": [{ "value": "#ffffff", "theme": { "mode": "light" } }] } },
  "children": [
    { "id": "light", "type": "frame", "width": 100, "height": 100, "children": [{ "id": "light-box", "type": "rectangle", "width": 10, "height": 10, "fill": "$bg" }] }
  ]
}
