{
  "version": "2.6",
  "themes": { "mode": ["light", "dark"] },
  "variables": { "bg": { "type": "color", "value": [{ "value": "#fff" }, { "value": "#000", "theme": { "mode": "dark" } }] }, "size": { "type": "number", "value": 4 }, "full": { "type": "color", "value": [{ "value": "#fff", "theme": { "mode": "light" } }, { "value": "#000", "theme": { "mode": "dark" } }] } },
  "children": [
    { "id": "dark", "type": "frame", "width": 100, "height": 100, "theme": { "mode": "dark" }, "children": [{ "id": "dark-box", "type": "rectangle", "width": 10, "height": 10, "fill": "$bg" }] }
  ]
}
