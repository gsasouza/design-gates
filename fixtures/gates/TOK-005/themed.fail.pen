{
  "version": "2.6",
  "themes": { "mode": ["light", "dark"] },
  "variables": {
    "accent": { "type": "color", "value": [{ "value": "#111111", "theme": { "mode": "light" } }, { "value": "#222222", "theme": { "mode": "dark" } }] }
  },
  "children": [
    {
      "id": "light",
      "type": "frame",
      "width": 100,
      "height": 100,
      "theme": { "mode": "light" },
      "children": [{ "id": "in-light", "type": "rectangle", "width": 10, "height": 10, "fill": "#222222" }]
    },
    {
      "id": "dark",
      "type": "frame",
      "width": 100,
      "height": 100,
      "theme": { "mode": "dark" },
      "children": [{ "id": "in-dark", "type": "rectangle", "width": 10, "height": 10, "fill": "#222222" }]
    }
  ]
}
