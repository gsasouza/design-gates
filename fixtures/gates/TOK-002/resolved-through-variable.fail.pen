{
  "version": "2.6",
  "variables": {
    "space": {
      "type": "number",
      "value": 18
    },
    "alias": {
      "type": "number",
      "value": "$space"
    },
    "odd": {
      "type": "number",
      "value": 3
    }
  },
  "children": [
    {
      "id": "screen",
      "type": "frame",
      "width": 100,
      "height": 100,
      "children": [
        {
          "id": "a",
          "type": "rectangle",
          "width": 10,
          "height": 10,
          "gap": "$alias"
        },
        {
          "id": "b",
          "type": "rectangle",
          "width": 10,
          "height": 10,
          "cornerRadius": "$odd",
          "stroke": {
            "fill": "#000000",
            "thickness": "$odd"
          }
        }
      ]
    }
  ]
}
