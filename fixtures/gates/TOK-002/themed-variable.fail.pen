{
  "version": "2.6",
  "themes": {
    "density": [
      "cozy",
      "compact"
    ]
  },
  "variables": {
    "space": {
      "type": "number",
      "value": [
        {
          "value": 16,
          "theme": {
            "density": "cozy"
          }
        },
        {
          "value": 18,
          "theme": {
            "density": "compact"
          }
        }
      ]
    }
  },
  "children": [
    {
      "id": "screen",
      "type": "frame",
      "width": 100,
      "height": 100,
      "children": [
        {
          "id": "a",
          "type": "rectangle",
          "width": 10,
          "height": 10,
          "gap": "$space"
        }
      ]
    }
  ]
}
