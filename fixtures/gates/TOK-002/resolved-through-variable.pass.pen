{
  "version": "2.6",
  "variables": {
    "space": {
      "type": "number",
      "value": 16
    },
    "alias": {
      "type": "number",
      "value": "$space"
    }
  },
  "children": [
    {
      "id": "screen",
      "type": "frame",
      "width": 100,
      "height": 100,
      "children": [
        {
          "id": "a",
          "type": "rectangle",
          "width": 10,
          "height": 10,
          "gap": "$alias"
        }
      ]
    }
  ]
}
