{
  "version": "2.6",
  "variables": {
    "c": {
      "type": "color",
      "value": "#000000"
    }
  },
  "children": [
    {
      "id": "screen",
      "type": "frame",
      "width": 100,
      "height": 100,
      "children": [
        {
          "id": "box",
          "type": "rectangle",
          "width": 10,
          "height": 10,
          "gap": 16,
          "padding": [
            16,
            20
          ],
          "cornerRadius": 6,
          "fontSize": 16,
          "stroke": {
            "fill": "$c",
            "thickness": 2
          }
        }
      ]
    }
  ]
}
