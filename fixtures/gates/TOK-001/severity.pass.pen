{
  "version": "2.6",
  "variables": {
    "c": {
      "type": "color",
      "value": "#FF0000"
    },
    "g": {
      "type": "number",
      "value": 8
    },
    "f": {
      "type": "string",
      "value": "Inter"
    }
  },
  "children": [
    {
      "id": "screen",
      "type": "frame",
      "width": 100,
      "height": 100,
      "children": [
        {
          "id": "box",
          "type": "rectangle",
          "width": 10,
          "height": 10,
          "fill": "$c",
          "gap": "$g",
          "cornerRadius": "$g",
          "fontSize": "$g",
          "fontFamily": "$f",
          "stroke": {
            "fill": "$c",
            "thickness": "$g"
          },
          "effect": {
            "type": "shadow",
            "color": "$c",
            "blur": 4
          }
        }
      ]
    }
  ]
}
