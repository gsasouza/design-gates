{
  "version": "2.6",
  "children": [
    {
      "id": "screen",
      "type": "frame",
      "width": 100,
      "height": 100,
      "children": [
        {
          "id": "box",
          "type": "rectangle",
          "width": 10,
          "height": 10,
          "fill": "#FF0000",
          "gap": 8,
          "cornerRadius": 4,
          "fontSize": 14,
          "fontFamily": "Inter",
          "stroke": {
            "fill": "#000000",
            "thickness": 2
          },
          "effect": {
            "type": "shadow",
            "color": "#00000040",
            "blur": 4
          }
        }
      ]
    }
  ]
}
