{
  "version": "2.6",
  "variables": {
    "c": {
      "type": "color",
      "value": "#CCCCCC"
    }
  },
  "children": [
    {
      "id": "screen",
      "type": "frame",
      "width": 100,
      "height": 100,
      "children": [
        {
          "id": "fillStr",
          "type": "rectangle",
          "width": 10,
          "height": 10,
          "fill": "#111111"
        },
        {
          "id": "fillObj",
          "type": "rectangle",
          "width": 10,
          "height": 10,
          "fill": {
            "type": "color",
            "color": "#222222"
          }
        },
        {
          "id": "fillArr",
          "type": "rectangle",
          "width": 10,
          "height": 10,
          "fill": [
            {
              "type": "color",
              "color": "#333333"
            },
            {
              "type": "color",
              "color": "#444444"
            },
            {
              "type": "color",
              "color": "#555555",
              "enabled": false
            }
          ]
        },
        {
          "id": "strokeStr",
          "type": "rectangle",
          "width": 10,
          "height": 10,
          "stroke": "#666666"
        },
        {
          "id": "strokeObj",
          "type": "rectangle",
          "width": 10,
          "height": 10,
          "stroke": {
            "fill": "#777777",
            "thickness": {
              "top": 3,
              "left": 5
            }
          }
        },
        {
          "id": "strokeArr",
          "type": "rectangle",
          "width": 10,
          "height": 10,
          "stroke": [
            {
              "fill": "#888888"
            },
            {
              "fill": "#999999"
            }
          ]
        },
        {
          "id": "fxObj",
          "type": "rectangle",
          "width": 10,
          "height": 10,
          "effect": {
            "type": "shadow",
            "color": "#AAAAAA"
          }
        },
        {
          "id": "fxArr",
          "type": "rectangle",
          "width": 10,
          "height": 10,
          "effect": [
            {
              "type": "shadow",
              "color": "#BBBBBB"
            },
            {
              "type": "shadow",
              "color": "$c"
            }
          ]
        },
        {
          "id": "pad",
          "type": "rectangle",
          "width": 10,
          "height": 10,
          "padding": [
            4,
            8
          ]
        },
        {
          "id": "radii",
          "type": "rectangle",
          "width": 10,
          "height": 10,
          "cornerRadius": [
            1,
            2,
            3,
            4
          ]
        }
      ]
    }
  ]
}