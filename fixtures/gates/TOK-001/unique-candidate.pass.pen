{
  "version": "2.6",
  "variables": {
    "danger": {
      "type": "color",
      "value": "#ff0000"
    }
  },
  "children": [
    {
      "id": "screen",
      "type": "frame",
      "width": 100,
      "height": 100,
      "children": [
        {
          "id": "box",
          "type": "rectangle",
          "width": 10,
          "height": 10,
          "fill": "$danger"
        }
      ]
    }
  ]
}
