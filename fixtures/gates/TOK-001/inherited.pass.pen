{
  "version": "2.6",
  "variables": {
    "brand": {
      "type": "color",
      "value": "#ABCDEF"
    }
  },
  "children": [
    {
      "id": "btn",
      "type": "frame",
      "reusable": true,
      "width": 50,
      "height": 20,
      "fill": "$brand",
      "children": [
        {
          "id": "label",
          "type": "text",
          "content": "x",
          "fill": "$brand"
        }
      ]
    },
    {
      "id": "screen",
      "type": "frame",
      "width": 100,
      "height": 100,
      "children": [
        {
          "id": "b1",
          "type": "ref",
          "ref": "btn"
        },
        {
          "id": "b2",
          "type": "ref",
          "ref": "btn"
        }
      ]
    }
  ]
}
