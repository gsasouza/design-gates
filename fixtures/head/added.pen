          "name": "brand-new-card",
          "width": 120,
          "height": 20,
          "fill": "#0a0b0c"
        },
        {
          "id": "brand-new-chip",
          "type": "rectangle",
          "name": "brand-new-chip",
          "width": 40,
          "height": 20,
          "fill": "#aa00aa",
          "x": 130
        }
      ]
    }
  ]
}
