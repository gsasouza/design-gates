{
  "version": "2.6",
  "children": [
    {
      "id": "file-added-frame",
      "type": "frame",
      "name": "FileAdded",
      "layout": "none",
      "width": 320,
      "height": 180,
      "children": [
        {
          "id": "brand-new-title",
          "type": "text",
          "name": "brand-new-title",
