{
  "name": "design-gates",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "bin": {
    "design-gates": "dist/src/cli.js",
    "design": "dist/src/design-cli.js"
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p . && node -e \"fs.mkdirSync('dist/src/report/assets',{recursive:true});for(const f of fs.readdirSync('src/report/assets'))fs.writeFileSync('dist/src/report/assets/'+f,fs.readFileSync('src/report/assets/'+f))\" && node -e \"for(const f of ['cli','design-cli'])fs.chmodSync('dist/src/'+f+'.js',0o755)\"",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "screenshot": "node scripts/screenshot.mjs",
    "fixtures:fig": "npm run build && node scripts/gen-fig-fixtures.mjs"
  },
  "devDependencies": {
    "@types/jsdom": "21.1.7",
    "@types/node": "22.20.5",
    "@types/pngjs": "6.0.5",
    "jsdom": "26.1.0",
    "playwright": "1.63.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@open-pencil/core": "0.16.0",
    "fzstd": "0.1.1",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0"
  }
}
